# Configuración de mongoSink para la sonda.
#
# Aplicar con:  t2conf mongoSink -C mongoSink.config && t2build -R mongoSink
#
# En una sonda gestionada por Salt, este fichero se genera desde el pillar
# (states/tranalyzer.sls) con el host y la colección propios de cada sonda.
# MONGO_HOST también puede sobreescribirse en tiempo de ejecución con la
# variable de entorno MONGO_HOST (ver run-tranalyzer.sh), gracias al mecanismo
# ENVCNTRL de Tranalyzer.

# :name: mongoSink                                                             #

# Longitud máxima de la query [0 - 65535]
MONGO_QRY_LEN = 2048

# Dirección de la base de datos central (coordinador por WireGuard)
MONGO_HOST = "10.0.0.1"

# Puerto de MongoDB
MONGO_PORT = 27017

# Nombre de la base de datos
MONGO_DBNAME = "tranalyzer"

# Colección de flujos. Convención multi-sonda: una colección por sonda
# (flow_<id>), de modo que el panel pueda atribuir los flujos a cada una.
MONGO_TABLE_NAME = "flow"

# Nº de documentos (flujos) a insertar por lote [1 - 65535]
MONGO_NUM_DOCS = 1

# Insertar solo campos concretos (usar MONGO_SELECT_FILE)
MONGO_SELECT = no

# Suprimir campos/arrays vacíos en la salida
BSON_SUPPRESS_EMPTY_ARRAY = yes

# Mensajes de depuración
BSON_DEBUG = no
