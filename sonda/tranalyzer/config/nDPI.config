# Configuración de nDPI para la sonda (clasificación de protocolos L7).
#
# Aplicar con:  t2conf nDPI -C nDPI.config && t2build -R nDPI

# :name: nDPI                                                                  #

# No volcar el ID numérico del protocolo
NDPI_OUTPUT_NUM = no
# Volcar el nombre del protocolo (columna nDPIclass)
NDPI_OUTPUT_STR = yes
# Estadísticas por protocolo (fichero *_nDPI.txt)
NDPI_OUTPUT_STATS = yes
# Intentar adivinar protocolos no reconocidos
NDPI_GUESS_UNKNOWN = yes
