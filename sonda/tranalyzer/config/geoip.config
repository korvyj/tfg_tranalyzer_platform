# Configuración de geoip para la sonda (geolocalización de IPs origen y destino).
#
# Aplicar con:  t2conf geoip -C geoip.config && t2build -R geoip
#
# Usa la base de datos GeoLite2-City.mmdb incluida con el plugin de Tranalyzer.

# :name: geoip                                                                 #

# Librería: 2 = GeoLite2 / libmaxmind interna (más rápida)
GEOIP_LIB = 2

GEOIP_SRC = yes
GEOIP_DST = yes

# Código de continente de dos letras
GEOIP_CONTINENT = 2
# Código de país de dos letras
GEOIP_COUNTRY = 2
GEOIP_CITY = yes
GEOIP_POSTCODE = yes
GEOIP_POSITION = yes
GEOIP_METRO_CODE = no
GEOIP_ACCURACY = yes
GEOIP_TIMEZONE = yes
GEOIP_UNKNOWN = "--"

GEOIP_DB_FILE = "GeoLite2-City.mmdb"
GEOIP_LANG = "en"
GEOIP_BUFSIZE = 64
# Caché en memoria (más rápido)
GEOIP_DB_CACHE = 2
